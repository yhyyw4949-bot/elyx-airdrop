# Telegram bot token from @BotFather (required)
BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Public HTTPS URL where this app is hosted (required for the Mini App),
# e.g. https://airdrop.example.com - no trailing slash
WEBAPP_URL=https://your-domain.example

# Your Telegram user ID(s), comma-separated. These accounts get admin commands.
# Find your ID by messaging @userinfobot.
ADMIN_IDS=111111111,222222222

# Telegram channel users must join (public channel, with the @).
# The bot must be added to the channel as an admin so it can check membership.
CHANNEL_USERNAME=@your_channel

# Optional: a Telegram group users must also join. Leave empty to skip.
GROUP_USERNAME=

# X (Twitter) profile users must follow
X_PROFILE_URL=https://x.com/your_handle

# Name of your token, used in the app and messages
TOKEN_NAME=ELYX

# Points earned per successful referral
POINTS_PER_REFERRAL=10

# Wallet address validation (regex).
# TON user-friendly addresses (UQ.../EQ...) - default:
WALLET_PATTERN=^[EU]Q[A-Za-z0-9_-]{46}$
# EVM (Ethereum, BSC, Polygon, ...):  WALLET_PATTERN=^0x[a-fA-F0-9]{40}$
# Solana:                             WALLET_PATTERN=^[1-9A-HJ-NP-Za-km-z]{32,44}$

# SQLite database file location
DB_PATH=airdrop.db

# Port the web app listens on
PORT=8000

# --- Campaign phases -------------------------------------------------------------
# The campaign runs in 4 phases; the admin moves between them with /phase:
#   1 Whitelist registration  2 Points collection  3 Token conversion  4 Airdrop
# Auto-approve everyone who joins the whitelist in phase 1 (true/false).
# Set false to review members yourself with /whitelist and /approve.
WHITELIST_AUTO_APPROVE=true

# How many points make 1 ELYX in the phase-3 conversion
POINTS_PER_TOKEN=1
